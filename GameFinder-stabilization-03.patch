+  const before = JSON.stringify({ input, identities });
+  const result = preview(input, identities, [identities[1].id], false);
+  assert.deepEqual(
+    result.rows.map((r) => r.status),
+    [
+      "ready",
+      "duplicate",
+      "already-owned",
+      "review",
+      "ambiguous",
+      "unresolved",
+      "review",
