+test("preview preserves ambiguity and requires verified identity without title-only matching", () => {
+  const identities = [
+    fixture(1),
+    fixture(2),
+    fixture(3, "3", { conflictStatus: "review-required" }),
+    fixture(4, "4"),
+    fixture(5, "4"),
+  ];
+  const input = [
+    claim(1),
+    claim(1),
+    claim(2),
+    claim(3),
+    claim(4),
+    claim(9, "Fixture 1"),
