diff --git a/src/lib/scan-barcode.ts b/src/lib/scan-barcode.ts
new file mode 100644
index 0000000..5d82d99
--- /dev/null
+++ b/src/lib/scan-barcode.ts
@@ -0,0 +1,58 @@
+import type { ScanHit } from "./scan";
+
+export type BarcodeReference = { gtin: string; bggId: string; name: string; source: string };
+/** Only publisher/authorized, edition-specific product mappings belong here. */
+export const APPROVED_BARCODE_REFERENCES: readonly BarcodeReference[] = [];
+
+export function normalizeGtin(raw: string): string | null {
+  const code = raw.trim();
+  if (!/^\d+$/.test(code) || ![8, 12, 13, 14].includes(code.length)) return null;
+  const digits = code.split("").map(Number);
+  const check = digits.pop()!;
+  const sum = digits.reverse().reduce((acc, n, i) => acc + n * (i % 2 === 0 ? 3 : 1), 0);
+  return (10 - (sum % 10)) % 10 === check ? code.padStart(14, "0") : null;
+}
+export function matchBarcode(raw: string, refs: readonly BarcodeReference[]): ScanHit | null {
+  const key = normalizeGtin(raw);
+  if (!key) return null;
+  const matches = refs.filter((r) => r.source.trim() && normalizeGtin(r.gtin) === key);
+  if (matches.length !== 1) return null;
+  const { bggId, name } = matches[0];
+  return { bggId, name, confidence: "review" };
+}
+export async function readLocalBarcodes(photo: HTMLCanvasElement, signal: AbortSignal) {
+  const Detector = (
+    globalThis as typeof globalThis & {
+      BarcodeDetector?: new (options: { formats: string[] }) => {
+        detect(image: HTMLCanvasElement): Promise<{ rawValue: string }[]>;
+      };
+    }
+  ).BarcodeDetector;
+  if (!Detector) return { supported: false, count: 0, hits: [] as ScanHit[] };
+  try {
+    signal.throwIfAborted();
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const detection = new Detector({ formats: ["ean_8", "ean_13", "upc_a"] }).detect(photo);
+    const detected = await Promise.race([
+      detection,
+      new Promise<never>((_, reject) => {
+        timer = setTimeout(() => reject(new Error("Barcode timeout")), 2500);
+      }),
+    ]).finally(() => clearTimeout(timer));
+    signal.throwIfAborted();
+    const codes = [
+      ...new Set(
+        detected.map((d) => normalizeGtin(d.rawValue)).filter((v): v is string => v !== null),
+      ),
+    ];
+    return {
+      supported: true,
+      count: codes.length,
+      hits: codes
+        .map((c) => matchBarcode(c, APPROVED_BARCODE_REFERENCES))
+        .filter((h): h is ScanHit => h !== null),
+    };
+  } catch {
+    return { supported: false, count: 0, hits: [] as ScanHit[] };
+  }
+}
diff --git a/src/lib/scan-evidence.ts b/src/lib/scan-evidence.ts
new file mode 100644
index 0000000..e8e678d
--- /dev/null
+++ b/src/lib/scan-evidence.ts
@@ -0,0 +1,53 @@
+import { boxTitleKey } from "./box-titles";
+import type { ScanHit } from "./scan";
+
+export type RecognitionSource = "ocr" | "visual" | "reference" | "barcode";
+export type ScanEvidence = { source: RecognitionSource; hit: ScanHit };
+export type ScanCatalogIdentity = { bggId: string; name: string };
+export type ReviewCandidate = ScanHit & { sources: RecognitionSource[] };
+
+/** Provider-independent identity resolution. No uncalibrated signal is auto-selected. */
+export function resolveScanEvidence(
+  evidence: readonly ScanEvidence[],
+  catalog: readonly ScanCatalogIdentity[],
+  blockedIds: ReadonlySet<string> = new Set(),
+): ReviewCandidate[] {
+  const results = new Map<string, ReviewCandidate>();
+  // Explicit same-title expansion evidence prevents a base-game candidate from
+  // being offered for this photo. A user can still search for the correct edition.
+  const expansionTitles = new Set(
+    evidence.filter((e) => e.hit.possibleExpansion === true).map((e) => boxTitleKey(e.hit.name)),
+  );
+  for (const { source, hit } of evidence) {
+    const name = hit.name.trim();
+    if (!name || name.length > 120) continue;
+    const title = boxTitleKey(name);
+    if (!title) continue;
+    const named = catalog.filter((game) => boxTitleKey(game.name) === title);
+    const game =
+      named.length === 1 &&
+      !hit.possibleExpansion &&
+      !expansionTitles.has(title) &&
+      (!hit.bggId || hit.bggId === named[0].bggId) &&
+      !blockedIds.has(named[0].bggId) &&
+      catalog.filter((g) => g.bggId === named[0].bggId).length === 1
+        ? named[0]
+        : undefined;
+    // A known conflicting base title is deliberately not offered as an automatic/custom match.
+    if (named.some((g) => blockedIds.has(g.bggId))) continue;
+    const key = game ? "id:" + game.bggId : "title:" + title;
+    const previous = results.get(key);
+    if (previous) {
+      if (!previous.sources.includes(source)) previous.sources.push(source);
+      continue;
+    }
+    results.set(key, {
+      bggId: game?.bggId ?? null,
+      name: game?.name ?? name,
+      confidence: game ? "review" : "unknown",
+      possibleExpansion: hit.possibleExpansion,
+      sources: [source],
+    });
+  }
+  return [...results.values()];
+}
