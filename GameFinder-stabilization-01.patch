diff --git a/src/lib/vault-policy.ts b/src/lib/vault-policy.ts
new file mode 100644
index 0000000..ef284cf
--- /dev/null
+++ b/src/lib/vault-policy.ts
@@ -0,0 +1,20 @@
+import { FREE_VAULT_LIMIT } from "./types";
+export type VaultSnapshot = { owned: string[]; wishlist: string[] };
+export function normalizeVault(input: VaultSnapshot): VaultSnapshot {
+  if (!Array.isArray(input?.owned) || !Array.isArray(input?.wishlist))
+    throw new Error("Invalid Vault snapshot");
+  const ids = (values: string[]) => {
+    if (values.some((id) => typeof id !== "string" || !id.trim() || id.length > 256))
+      throw new Error("Invalid Vault game id");
+    return Array.from(new Set(values));
+  };
+  const owned = ids(input.owned);
+  const set = new Set(owned);
+  return { owned, wishlist: ids(input.wishlist).filter((id) => !set.has(id)) };
+}
+export function assertVaultCapacity(previous: string[], next: string[], premium: boolean) {
+  if (premium || next.length <= FREE_VAULT_LIMIT) return;
+  const prior = new Set(previous);
+  if (next.some((id) => !prior.has(id)))
+    throw new Error("Free vaults hold up to 50 games. Existing games are preserved.");
+}
diff --git a/src/lib/vault-sync.server.ts b/src/lib/vault-sync.server.ts
new file mode 100644
index 0000000..db4e8c5
--- /dev/null
+++ b/src/lib/vault-sync.server.ts
@@ -0,0 +1,31 @@
+import type { Sql } from "./db";
+import { normalizeVault, assertVaultCapacity, type VaultSnapshot } from "./vault-policy";
+import { hasPremiumPlan } from "./premium-entitlement.server";
+
+/** Caller must provide an atomic transaction and lock the account row first. */
+export async function replaceVaultSnapshot(sql: Sql, userId: string, input: VaultSnapshot) {
+  const data = normalizeVault(input);
+  const profile = await sql<{
+    plan: string;
+  }>`select plan from profiles where user_id = ${userId} for update`;
+  if (!profile.length) throw new Error("Vault account unavailable");
+  const current = await sql<{
+    bgg_id: string;
+  }>`select bgg_id from vault_games where user_id = ${userId} and list = 'owned'`;
+  const premium =
+    userId === "dev-user" ? await hasPremiumPlan(userId) : profile[0].plan === "premium";
+  assertVaultCapacity(
+    current.map((row) => row.bgg_id),
+    data.owned,
+    premium,
+  );
+  await sql`delete from vault_games where user_id = ${userId}`;
+  for (const [list, ids] of [
+    ["owned", data.owned],
+    ["wishlist", data.wishlist],
+  ] as const) {
+    if (ids.length)
+      await sql`insert into vault_games (user_id, bgg_id, list) select ${userId}, value, ${list} from jsonb_array_elements_text(${JSON.stringify(ids)}::jsonb) as value`;
+  }
+  return { ok: true as const };
+}
