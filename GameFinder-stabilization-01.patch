+/** A single connection for the entire transaction, never pooled BEGIN/COMMIT. */
+export async function withSqlTransaction<T>(work: (sql: Sql) => Promise<T>): Promise<T> {
+  await getSql();
+  if (dbSource === "pglite") {
+    const pg = await getPglite();
+    return pg.transaction((tx) =>
