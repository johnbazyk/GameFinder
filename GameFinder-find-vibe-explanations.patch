From b9d4143c8fe735d91ebfbbe856d08fc5c9c1e50e Mon Sep 17 00:00:00 2001
From: Codex <codex@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:56:00 -0700
Subject: [PATCH] Explain every qualifying Find vibe with a game-specific move

---
 docs/ratings/standard-0.4-design.md   |   4 +
 scripts/design-ratings.test.mjs       |  13 ++
 src/lib/ratings/design-assessments.ts | 293 ++++++++++++++++++++++++--
 3 files changed, 297 insertions(+), 13 deletions(-)

diff --git a/docs/ratings/standard-0.4-design.md b/docs/ratings/standard-0.4-design.md
index 60da403..2467ebe 100644
--- a/docs/ratings/standard-0.4-design.md
+++ b/docs/ratings/standard-0.4-design.md
@@ -32,6 +32,10 @@ Find applies player, youngest age, time, content and explicit advanced rating ta
 
 The UI retains one seven-axis graph, integer ticks 1–5, half-point plotting, and a short provisional label. Evidence stays in the data rather than expanding the consumer interface. Personal rating overrides are not implemented by this patch.
 
+## Writing Find explanations
+
+For each ordinary Find vibe a game qualifies for, give one short sentence grounded in its recorded rules. Name something a player does or sees and show why it matters for that vibe. For Luck, describe what the draw or roll changes. For Strategy, show a choice and its consequence. For Family, show how someone participates. The first sentence in the record also appears when a search has no vibe preference, so it should make sense on its own. Keep the player count, age, time and scores in their existing fields.
+
 ## Verification and remaining work
 
 Automated checks cover all authored identities, eleven valid half-point values, provisional status, strict reviewed-mode exclusion, age-independent Family with separate hard age checks, supported scopes, all active game profiles rendering, shared Find/Discover filtering, and three-plus-three/reroll behavior. Passing software tests confirms implementation contracts, not the validity of every judgment.
diff --git a/scripts/design-ratings.test.mjs b/scripts/design-ratings.test.mjs
index 5c2293e..378d595 100644
--- a/scripts/design-ratings.test.mjs
+++ b/scripts/design-ratings.test.mjs
@@ -187,6 +187,19 @@ test("every catalog entry has distinct, short rules-based copy for Find", () =>
   }
 });
 
+test("every ordinary Find vibe a game matches has its own explanation", () => {
+  for (const game of catalog.AUTHORED_GAMES) {
+    const record = app.ratingRecord(game);
+    for (const vibe of Object.keys(vibes.VIBE_META)) {
+      const ctx = context({ vibes: [vibe] });
+      if (!app.gameMatchesRatings(game, ctx)) continue;
+      const reason = record.matchReasons[vibe];
+      assert.ok(reason, `${game.name} needs a reason for ${vibe}`);
+      assert.equal(app.ratingExplanation(game, ctx), reason);
+    }
+  }
+});
+
 test("owned and unowned cards use the same evidence and prefer a matched vibe on closest fits", () => {
   const game = catalog.GAMES.find((g) => g.name === "Carcassonne");
   const ctx = context({ players: 2, vibes: ["luck", "board", "party"] });
