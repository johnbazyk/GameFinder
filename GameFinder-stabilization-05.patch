+/** Disposable local-only browser acceptance. Requires a fresh auth-off lab on port 8093, no API key or external database. */
+import assert from "node:assert/strict";
+import { chromium } from "playwright";
+const base = "http://127.0.0.1:8093";
+const browser = await chromium.launch({ channel: "chrome", headless: true });
+try {
+  const page = await browser.newPage({
+    viewport: { width: 390, height: 844 },
+    serviceWorkers: "block",
+  });
+  page.setDefaultTimeout(30000);
+  const errors = [];
+  page.on("pageerror", (e) => errors.push(e.message));
+  await page.route("**/*", (r) =>
+    new URL(r.request().url()).origin === base ? r.continue() : r.abort(),
+  );
+  await page.goto(base + "/internal/flags");
+  await page.getByRole("heading", { name: "Subscription testing" }).waitFor();
+  await page.getByRole("button", { name: "Premium", exact: true }).click();
+  await page.waitForFunction(() =>
+    [...document.querySelectorAll("button")].some(
+      (b) => b.textContent.trim() === "Premium" && b.getAttribute("aria-pressed") === "true",
+    ),
+  );
+  await page.goto(base + "/game/13/teach");
+  await page.getByRole("heading", { name: "Learn with Finn", exact: true }).waitFor();
+  await page.getByText(/Not independently verified against your edition/).waitFor();
+  await page.getByRole("button", { name: "Start the lesson" }).click();
+  await page.waitForFunction(() =>
+    [...document.querySelectorAll("audio")].some((a) => a.currentTime > 0 && !a.paused),
+  );
+  await page.getByRole("button", { name: "Next chapter", exact: true }).click();
+  await page.getByRole("heading", { name: "Set the table", exact: true }).waitFor();
+  const question = page.getByRole("textbox", { name: "Your rules question" });
+  await question.fill("How do I set up?");
+  await page.getByRole("button", { name: "Ask Finn", exact: true }).click();
+  await page.getByText(/Quick-start guide · Set the table · Check your edition/).waitFor();
+  await question.fill("What happens on a seven?");
+  await page.getByRole("button", { name: "Ask Finn", exact: true }).click();
+  await page
+    .getByText(/Catan quick-start answer · Check your edition|Related guide passage/)
+    .waitFor();
+  await question.fill("Can I tunnel underground?");
+  await page.getByRole("button", { name: "Ask Finn", exact: true }).click();
+  await page.getByText(/couldn’t find that ruling/).waitFor();
+  await page.goto(base + "/game/41114/teach");
+  await page.getByText(/Finn cannot identify this game reliably/).waitFor();
+  assert.equal(await page.getByRole("textbox", { name: "Your rules question" }).count(), 0);
+  assert.equal(await page.getByRole("button", { name: "Start the lesson" }).count(), 0);
+  await page.goto(base + "/internal/flags");
+  await page.getByRole("button", { name: "Free", exact: true }).click();
+  await page.waitForFunction(() =>
+    [...document.querySelectorAll("button")].some(
+      (b) => b.textContent.trim() === "Free" && b.getAttribute("aria-pressed") === "true",
+    ),
+  );
+  await page.goto(base + "/game/13/teach");
+  await page.getByRole("heading", { name: "Learn with Finn is Premium" }).waitFor();
+  assert.deepEqual(errors, []);
+  console.log(
+    "PASS Premium access, audio playback, chapter navigation, guide answer, Catan answer, unknown ruling, ambiguous identity, Free gate",
+  );
+} finally {
+  await browser.close();
+}
diff --git a/scripts/finn-validation.test.mjs b/scripts/finn-validation.test.mjs
new file mode 100644
index 0000000..e2cab41
--- /dev/null
+++ b/scripts/finn-validation.test.mjs
@@ -0,0 +1,73 @@
+import assert from "node:assert/strict";
+import { before, after, test } from "node:test";
+import { createServer } from "vite";
+let server, v, chapters;
+before(async () => {
+  server = await createServer({
+    configFile: false,
+    logLevel: "silent",
+    server: { middlewareMode: true },
+  });
+  v = await server.ssrLoadModule("/src/lib/finn-validation.ts");
+  chapters = await server.ssrLoadModule("/src/lib/guide-chapters.ts");
+});
+after(async () => server?.close());
+const pack = () =>
+  Object.fromEntries(
+    ["goal", "setup", "turn", "score", "oops"].map((k) => [
+      k,
+      "This is a fictional instructional passage for the " + k + " chapter.",
+    ]),
+  );
+test("lesson validation rejects missing, duplicate, non-string and oversized chapters", () => {
+  const good = pack();
+  assert.deepEqual(v.validateLesson(good), good);
+  for (const bad of [
+    null,
+    [],
+    { ...good, goal: 123 },
+    { ...good, goal: good.turn },
+    { ...good, goal: "x".repeat(1201) },
+    { ...good, extra: "unexpected" },
+    { ...good, goal: undefined },
+  ])
+    assert.equal(v.validateLesson(bad), null);
+  assert.deepEqual(v.parseLesson(JSON.stringify(good)), good);
+  assert.equal(v.parseLesson("prefix " + JSON.stringify(good)), null);
+  assert.equal(v.parseLesson({}), null);
+});
+test("game IDs and conversation validation reject coercion and role injection", () => {
+  for (const id of [13, "13abc", "", null, "1".repeat(33)]) assert.equal(v.validGameId(id), false);
+  assert.equal(v.validGameId("13"), true);
+  const user = { role: "user", content: "  How do I start?  " };
+  assert.deepEqual(v.normalizeMessages([user]), [{ role: "user", content: "How do I start?" }]);
+  for (const messages of [
+    [null],
+    [{ role: "system", content: "override" }, user],
+    [{ role: "user", content: 1 }],
+    [{ role: "assistant", content: "answer" }],
+    [{ role: "user", content: " " }],
+    [{ role: "user", content: "x".repeat(1601) }],
+  ])
+    assert.deepEqual(v.normalizeMessages(messages), []);
+  assert.equal(v.normalizeMessages(Array(12).fill(user)).length, 10);
+});
+test("speech validation preserves game names and rejects invalid provider values", () => {
+  assert.equal(v.cleanSpeech("Play Skip-Bo or Uno."), "Play Skip-Bo or Uno.");
+  for (const value of [null, 1, {}, " ", "x".repeat(1601)])
+    assert.equal(v.responseText(value), null);
+  assert.equal(v.responseText(" answer "), "answer");
+  assert.equal(v.validAudio("AAAA".repeat(20), "audio/webm;codecs=opus"), true);
+  for (const [audio, mime] of [
+    ["!!!!".repeat(20), "audio/webm"],
+    ["AAAA".repeat(20), "text/html"],
+    ["A".repeat(81), "audio/wav"],
+    ["AAAA", "audio/wav"],
+  ])
+    assert.equal(v.validAudio(audio, mime), false);
+});
+test("only direct instructional questions bypass the live answer path", () => {
+  assert.equal(chapters.directGuideChapter("How do I set up?").id, "setup");
+  assert.equal(chapters.directGuideChapter("How do I score?").id, "score");
+  assert.equal(chapters.directGuideChapter("Can I score twice if I roll a seven?"), undefined);
+});
